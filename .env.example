# Example environment variables for the CommerceFolio backend
# Rename this file to .env and fill in the actual values before running the project

# Database configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/commercefolio_db"
# If you do not have PostgreSQL available, remove or comment the line above.
# The backend will automatically use SQLite at the path defined below.
SQLITE_DB_FILE="commercefolio_app.db"

# Security settings
SECRET_KEY="change-me"
REFRESH_SECRET_KEY="change-me-refresh"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# CORS origins (comma separated list)
BACKEND_CORS_ORIGINS="http://localhost:5173"

# Default admin user
ADMIN_EMAIL="<ADMIN_EMAIL>"
ADMIN_PASSWORD="<ADMIN_PASSWORD>"
ADMIN_IDIOMA_PREFERIDO="pt-BR"
FIRST_SUPERUSER_EMAIL="<FIRST_SUPERUSER_EMAIL>"
FIRST_SUPERUSER_PASSWORD="<FIRST_SUPERUSER_PASSWORD>"

# Default limits for free plan
DEFAULT_LIMIT_PRODUTOS_SEM_PLANO=50
DEFAULT_LIMIT_ENRIQUECIMENTO_SEM_PLANO=10
DEFAULT_LIMIT_GERACAO_IA_SEM_PLANO=20

# Email configuration
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM=""
MAIL_PORT=587
MAIL_SERVER="smtp.example.com"
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_FROM_NAME="CommerceFolio Platform"
# When these email settings are not provided password reset emails will not be sent.
# Set RAISE_ON_MISSING_EMAIL_CONFIG=false to ignore the missing configuration instead of raising an error.
RAISE_ON_MISSING_EMAIL_CONFIG=True

# Additional SMTP configuration
SMTP_SERVER="smtp.seuprovedor.com"
SMTP_PORT=587
SMTP_USER="your@email.com"
SMTP_PASSWORD="senha"
EMAIL_FROM="CommerceFolio Platform <nao-responda@commercefolio.com>"

# OAuth2 / Social Login settings
# To enable Google login:
#   1. Create a project at https://console.cloud.google.com
#   2. Enable "Google+ API" and create OAuth 2.0 credentials (Web Application)
#   3. Add Authorized redirect URI: https://yourdomain.com/api/v1/auth/google/callback
#   4. Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET below
# Leave empty to disable Google login (buttons will appear grayed out).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# To enable Facebook login:
#   1. Create an app at https://developers.facebook.com
#   2. Add "Facebook Login" product, set Valid OAuth Redirect URI:
#      https://yourdomain.com/api/v1/auth/facebook/callback
#   3. Set FACEBOOK_CLIENT_ID and FACEBOOK_CLIENT_SECRET below
# Leave empty to disable Facebook login.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:8000/api/v1/auth/facebook/callback"

# Other application settings
FRONTEND_URL="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:8000/api/v1"
UPLOAD_DIRECTORY="static/uploads"
# Path to poppler binaries (required on Windows for PDF preview)
POPPLER_PATH=""
AI_PROVIDER="openai"
OPENAI_API_KEY=""
LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"
LM_STUDIO_MODEL=""
LM_STUDIO_API_KEY="lm-studio"
LM_STUDIO_MAX_CONCURRENCY=1
PDF_LLM_IMAGE_DPI=144
PDF_LLM_PAGE_SCAN_LIMIT=8
GOOGLE_GEMINI_API_KEY=""
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_ID=""
PLAYWRIGHT_PROXY_POOL_JSON=""
PLAYWRIGHT_GOTO_TIMEOUT_MS=30000
MAX_UPLOAD_BYTES=0
FILE_PARSE_TIMEOUT_SECONDS=30
FILE_PARSE_MAX_MEMORY_MB=0
ASYNC_DISPATCH_PROVIDER="background_tasks"
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
CELERY_TASK_ALWAYS_EAGER=False
CREDITOS_CUSTO_SUGESTAO_ATRIBUTOS_GEMINI=1

# Stripe Billing (leave empty to disable checkout — free-plan users are unaffected)
# 1. Create an account at https://dashboard.stripe.com
# 2. Copy your secret key from Developers → API keys
# 3. Create a recurring Price in Products → Add product → Recurring
# 4. Copy the Price ID (price_xxx) into STRIPE_PRO_PRICE_ID
# 5. Set the webhook endpoint to: https://yourdomain.com/api/v1/billing/webhook
#    and copy the Webhook Signing Secret into STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""

# When set to true, the backend will attempt to create tables on startup
AUTO_CREATE_TABLES=False

# Runtime architecture mode (current):
# - oop: execute OOP pipeline
APP_MODE="oop"

ALLOW_USERS_TO_EDIT_GLOBAL_PRODUCT_TYPES=False
ALLOW_USERS_TO_DELETE_GLOBAL_PRODUCT_TYPES=False

# Uvicorn server configuration (optional)
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
BACKEND_RELOAD=True
BACKEND_WORKERS=1
